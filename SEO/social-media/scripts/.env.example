# Required for Facebook, Instagram, Quora, Twitter/X, LinkedIn, TikTok (and SERP fallback)
# Get a key at https://serper.dev
SERPER_API_KEY=

# Required for YouTube Data API search + stats
# Create at https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=

# Drafts (replies + posts). Optional — templates used if empty.
OPENAI_API_KEY=

# Model for drafts (default gpt-4.1-mini)
SOCIAL_AGENT_MODEL=gpt-4.1-mini

# Timezone for schedule_export.csv timestamps
SOCIAL_AGENT_TZ=America/New_York

# 1 = Reddit/Facebook group drafts force no product / no links (first 1–2 weeks)
SOCIAL_WARMUP=0

# Optional — Reddit public JSON works without auth; set these for higher rate limits
# Create an app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=IELTSGRADER-social-discovery/1.0
